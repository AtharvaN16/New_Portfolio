{
  "name": "portfolio-new",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,css,md}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,json,css,md}\"",
    "test": "vitest",
    "test:e2e": "playwright test",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "images:check": "node scripts/check-images.mjs",
    "images:audit": "node scripts/check-images.mjs --all",
    "images:optimize": "node scripts/optimize-images.mjs",
    "images:optimize:all": "node scripts/optimize-images.mjs --all",
    "images:migrate": "node scripts/optimize-images.mjs --migrate-only",
    "images:purge": "node scripts/purge-legacy-images.mjs",
    "images:purge:execute": "node scripts/purge-legacy-images.mjs --execute",
    "lhci": "npm run lhci:desktop && npm run lhci:mobile",
    "lhci:desktop": "lhci autorun --config=./lighthouserc.desktop.json",
    "lhci:mobile": "lhci autorun --config=./lighthouserc.mobile.json",
    "type-check": "tsc --noEmit",
    "validate": "npm run lint && npm run format:check && npm run type-check && npm run images:check && npm run test run",
    "remotion:studio": "remotion studio remotion/index.ts",
    "remotion:render": "remotion render remotion/index.ts UAlbertaReel --output out/ualberta-reel.mp4"
  },
  "dependencies": {
    "@remotion/bundler": "^4.0.467",
    "@remotion/cli": "^4.0.467",
    "@remotion/renderer": "^4.0.467",
    "@tailwindcss/typography": "^0.5.19",
    "@theme-toggles/react": "^4.1.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.23.24",
    "gsap": "^3.13.0",
    "lenis": "1.3.11",
    "next": "16.1.1",
    "next-transition-router": "^0.2.11",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-masonry-css": "^1.0.16",
    "react-remove-scroll": "^2.7.2",
    "remotion": "^4.0.467",
    "resend": "^6.9.3",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.49.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5.0.4",
    "baseline-browser-mapping": "^2.9.11",
    "eslint": "^9",
    "eslint-config-next": "16.0.0",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^27.0.1",
    "prettier": "^3.6.2",
    "sharp": "^0.35.2",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.0.2",
    "vitest-axe": "^0.1.0"
  }
}
