    "clsx": "^2.1.1",
    "framer-motion": "^12.23.24",
    "gsap": "^3.13.0",
    "lenis": "^1.3.11",
    "next": "^16.1.1",
    "next-transition-router": "^0.2.11",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-masonry-css": "^1.0.16",
